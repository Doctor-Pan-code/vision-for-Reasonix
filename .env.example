# ============================================
# vision-for-reasonix 环境变量配置
# ============================================
# 复制此文件为 .env 并填入真实值

# --- 必填：提供商选择 ---
# 可选值: siliconflow / openai / modelscope
VISION_PROVIDER=openai

# --- 必填：对应提供商的 API Key ---
# SiliconFlow: https://cloud.siliconflow.cn 注册获取
SILICONFLOW_API_KEY=sk-你的硅基流动APIKey
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-你的OpenAIAPIKey
# ModelScope: 魔搭个人中心获取
MODELSCOPE_API_KEY=你的魔搭APIKey

# --- 可选：自定义模型 ---
# 不填则使用各提供商的默认视觉模型
# SiliconFlow 默认: Qwen/Qwen2-VL-72B-Instruct
# OpenAI 默认: gpt-4o
# ModelScope 默认: Qwen/Qwen2-VL-72B-Instruct
VISION_MODEL=

# --- 可选：自定义 API Base URL ---
# 仅当你想覆盖默认的 API 端点时设置
# VISION_BASE_URL=
